#!/usr/bin/env python3
"""extract_spec: collect what the README, docs/ and docstrings promise about each class and function.

Usage: extract_spec [--list] [--name REGEX] [--claims KINDS] [--compact] [-o FILE] [--package PKG]

Prints JSON with one entry per public class, function, method and property of the package:
  name, kind, signature, docstring, defined_in, documented_signatures, bases, inherited, members,
  claims: [{text, kind, source: {file, line, origin}}]   origin is docstring, readme or docs
Claim kinds: behavior, param, returns, raises, default, example, usage, note, deprecated, complexity.
Doctest lines (>>> code, expected output) become "example" claims with code, expected and setup.
Statements no single class or function owns go to "general_claims".

Options:
  --list          one line per entity (name, kind, signature, number of claims) instead of JSON
  --name REGEX    only entities whose name matches, e.g. --name LRUCache or --name 'SortedList.add$'
  --claims KINDS  only claims of these kinds, e.g. --claims example,raises,returns
  --compact       leave out docstrings and duplicate sources (smaller output; claims stay complete)
  -o FILE         write the JSON to FILE instead of printing it
  --package PKG   package folder or module file to scan (repeatable; default: auto-detect)
  --private       also include private (_name) classes and functions
  --no-import     do not import the package (static analysis only)
Start with --list, then ask for the entities you are testing with --name.
"""

import argparse
import ast
import contextlib
import copy
import inspect
