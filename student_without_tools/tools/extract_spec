# reStructuredText (docs and docstrings)
# ----------------------------------------------------------------------------------------------------

class RstParser:
    """Splits reST into prose paragraphs, field-list items, doctests and code blocks, each tagged with
    the class or function the surrounding directive (or docstring) documents."""

    def __init__(self, spec: Spec, text, first_line, entity, module, targets, file=None):
        self.spec = spec
        self.lines = text.expandtabs().split("\n")
        self.first_line = first_line
        self.file = file
        self.targets = targets
        self.blocks: list[dict] = []
        self.stack = [{"indent": -1, "entity": entity, "cls": spec.class_of(entity) if entity else None,
                       "tag": None, "subject": None}]
        self.module = module
        self.section_levels: list = []
        self.skip_level = None
        self.session = 0
        self.fsec = None
        self.para = None

    def ln(self, i):
        return self.first_line + i

    def flush(self):
        para, self.para = self.para, None
        if para is None:
            return
        text = " ".join(s.strip() for s in para["lines"]).strip()
        if text or para["field"]:
            self.blocks.append({"type": "prose", "text": text, "line": para["line"], "nlines": len(para["lines"]),
                                "entity": para["entity"], "tag": para["tag"], "field": para["field"],
                                "skip": para["skip"], "subject": para["subject"], "module": self.module,
                                "session": self.session})

    def new_para(self, i, ind, text, field=None, tag=None):
        self.flush()
        top = self.stack[-1]
        self.para = {"lines": [text] if text else [], "line": self.ln(i), "indent": ind, "entity": top["entity"],
                     "tag": tag or top["tag"], "field": field, "skip": self.skip_level is not None,
                     "subject": top["subject"]}

    def body_end(self, i, base):
        n = len(self.lines)
        while i < n and (not self.lines[i].strip() or indent_of(self.lines[i]) > base):
            i += 1
        return i

    def add_code(self, start, end, directive, lang=None):
        body = self.lines[start:end]
        s, e = 0, len(body)
        while s < e and not body[s].strip():
            s += 1
        while e > s and not body[e - 1].strip():
            e -= 1
        if s >= e:
            return
        code = textwrap.dedent("\n".join(body[s:e]))
        top = self.stack[-1]
        base = {"line": self.ln(start + s), "entity": top["entity"], "skip": self.skip_level is not None,
                "module": self.module, "session": self.session}
        if directive == "testoutput":
            last = self.blocks[-1] if self.blocks else None
            if last and last["type"] == "code" and last.get("directive") == "testcode" and "output" not in last:
                last["output"] = code
            return
        if any(l.lstrip().startswith(">>>") for l in code.split("\n")):
            self.blocks.append(dict(base, type="doctest", steps=parse_doctest(code.split("\n"), base["line"])))
        else:
            self.blocks.append(dict(base, type="code", code=code, directive=directive, lang=lang))

    def heading(self, text, style):
        self.flush()
        del self.stack[1:]
        if style not in self.section_levels:
            self.section_levels.append(style)
        level = self.section_levels.index(style)
        self.session += 1
        low = text.strip().lower().rstrip(":")
        kind = SECTION_FIELD.get(low)
        self.fsec = {"kind": kind, "min": 0, "item": None, "style": "numpy"} if kind else None
        if self.skip_level is not None and level <= self.skip_level:
            self.skip_level = None
        if self.skip_level is None and SKIP_HEADING.search(text.strip()):
            self.skip_level = level

    def field_item(self, kind, text, style):
        """One item of a Google or numpy style section -> (kind, name, type), description."""
        if style == "numpy":  # "name : type" or just "type"; the description is on the next lines
            name, colon, typ = text.partition(" : ") if " : " in text else text.partition(":")
            if kind in ("param", "attribute"):
                return (kind, name.strip(), typ.strip() or None), ""
            if kind == "raises":
                return ("raises", text.strip(), None), ""
            return ("returns", None, (typ if colon else name).strip() or None), ""
        if kind in ("param", "attribute"):
            m = re.match(r"^(\*{0,2}[\w.]+(?:\s*,\s*\*{0,2}\w+)*)\s*(?:\(([^)]*)\))?\s*(?::\s*(.*))?$", text)
            if m:
                return (kind, m.group(1), m.group(2)), m.group(3) or ""
            return (kind, None, None), text
        m = re.match(r"^([\w.\[\], ]+?)\s*:\s*(.*)$", text)
        if m and (kind == "raises" or not re.search(r"\s", m.group(1).strip())):
            if kind == "raises":
                return ("raises", m.group(1).strip(), None), m.group(2)
            return ("returns", None, m.group(1).strip()), m.group(2)
        if kind == "raises" and re.match(r"^[\w.]+$", text):
            return ("raises", text, None), ""
        if kind == "returns" and re.match(r"^[\w.\[\], |]+$", text) and len(text) < 40:
            return ("returns", None, text), ""
        return (kind, None, None), text

    @staticmethod
    def rst_field(name, arg, rest):
        name = name.lower()
        words = (arg or "").split()
        if name in ("param", "parameter", "arg", "argument", "key", "keyword", "kwarg", "kwparam"):
            if not words:
                return None
            return ("param", words[-1], " ".join(words[:-1]) or None), rest
        if name == "type" and words:
            return ("type", words[-1], rest or None), ""
        if name in ("returns", "return", "yields", "yield"):
            return ("returns", None, None), rest
        if name in ("rtype", "ytype"):
            return ("rtype", None, rest or None), ""
        if name in ("raises", "raise", "except", "exception", "throws"):
            return ("raises", " ".join(words) or None, None), rest
        if name in ("ivar", "var", "cvar") and words:
            return ("attribute", words[-1], " ".join(words[:-1]) or None), rest
        return False

    def parse(self):
        lines, n = self.lines, len(self.lines)
        i = 0
        while i < n:
            line = lines[i]
            stripped = line.strip()
            if not stripped:
                self.flush()
                i += 1
                continue
            ind = indent_of(line)
            while len(self.stack) > 1 and ind <= self.stack[-1]["indent"]:
                self.flush()
                self.stack.pop()

            nxt = lines[i + 1].strip() if i + 1 < n else ""
            if is_rule(stripped) and i + 2 < n and nxt and not is_rule(nxt) and lines[i + 2].strip() == stripped:
                self.heading(nxt, (stripped[0], True))
                i += 3
                continue
            if self.para is None and not is_rule(stripped) and is_rule(nxt) and \
                    len(nxt) >= max(3, int(len(stripped) * 0.6)) and indent_of(lines[i + 1]) == ind \
                    and not stripped.startswith(".. "):
                self.heading(stripped, (nxt[0], False))
                i += 2
                continue
            if is_rule(stripped) and self.para is None:
                i += 1
                continue

            # Google / numpy style parameter sections
            if self.fsec is not None:
                fs = self.fsec
                if ind < fs["min"] or (DIRECTIVE_RE.match(line) and ind <= fs["min"]):
                    self.flush()
                    self.fsec = fs = None
                elif not stripped.startswith(">>>"):
                    if fs["item"] is None or ind <= fs["item"]:
                        fs["item"] = ind
                        field, desc = self.field_item(fs["kind"], stripped, fs["style"])
                        self.new_para(i, ind, desc, field=field)
                    elif self.para is not None:
                        self.para["lines"].append(stripped)
                    else:
                        self.new_para(i, ind, stripped)
                    i += 1
                    continue

            if stripped.startswith(">>>"):
                self.flush()
                j = i
                while j < n and lines[j].strip():
                    j += 1
                top = self.stack[-1]
                self.blocks.append({"type": "doctest", "steps": parse_doctest(lines[i:j], self.ln(i)),
                                    "line": self.ln(i), "entity": top["entity"], "skip": self.skip_level is not None,
                                    "module": self.module, "session": self.session})
                i = j
                continue

            if self.para is None and GOOGLE_RE.match(stripped):
                key = stripped.rstrip(":").strip().lower()
                kind = SECTION_FIELD.get(key)
                self.fsec = {"kind": kind, "min": ind + 1, "item": None, "style": "google"} if kind else None
                i += 1
                continue

            match = DIRECTIVE_RE.match(line)
            if match:
                i = self.directive(i, ind, match.group(2).split(":")[-1].lower(), (match.group(3) or "").strip())
                continue
            if stripped.startswith(".. ") or stripped == "..":
                self.flush()
                i = self.body_end(i + 1, ind)
                continue
            if stripped.startswith("__ "):
                i += 1
                continue

            field = FIELD_RE.match(stripped)
            if field:
                parsed = self.rst_field(field.group(1), field.group(2), field.group(3) or "")
                if parsed is False:
                    self.flush()
                    i = self.body_end(i + 1, ind)
                    continue
                if parsed is not None:
                    self.new_para(i, ind, parsed[1], field=parsed[0])
                    i += 1
                    continue

            bullet = BULLET_RE.match(stripped)
            if bullet:
                self.new_para(i, ind + len(bullet.group(1)) + 1, bullet.group(2))
            elif self.para is None:
                self.new_para(i, ind, stripped)
            else:
                self.para["lines"].append(stripped)

            if stripped.endswith("::"):
                last = self.para["lines"][-1] if self.para["lines"] else ""
                if last == "::":
                    self.para["lines"].pop()
                elif last.endswith(" ::"):
                    self.para["lines"][-1] = last[:-3]
                else:
                    self.para["lines"][-1] = last[:-1]
                base = self.para["indent"]
                self.flush()
                end = self.body_end(i + 1, base)
                self.add_code(i + 1, end, "literal")
                i = end
                continue
            i += 1
        self.flush()
        return self.blocks

    def directive(self, i, ind, name, arg):
        self.flush()
        lines, n = self.lines, len(self.lines)
        j = i + 1
        options = {}
        while j < n and lines[j].strip() and indent_of(lines[j]) > ind and OPTION_RE.match(lines[j].strip()):
            option = OPTION_RE.match(lines[j].strip())
            options[option.group(1)] = option.group(2) or ""
            j += 1
        top = self.stack[-1]
        if name in ENTITY_DIRECTIVES:
            m = re.match(r"^([\w.]+)\s*(\(.*\))?\s*(->.*)?$", arg)
            target, signature = (m.group(1), (m.group(2) or "") + (" " + m.group(3) if m.group(3) else "")) if m \
                else (arg.split("(")[0].strip(), "")
            eid = self.spec.resolve_ref(target, self.module, top["cls"]) if target else None
            more = []
            while j < n and lines[j].strip() and indent_of(lines[j]) > ind and \
                    re.match(r"^[\w.]+\s*\(.*\)\s*(->.*)?$", lines[j].strip()):
                more.append(lines[j].strip()[len(lines[j].strip().split("(")[0]):].strip())
                j += 1
            if eid:
                for sig in [signature.strip()] + more:
                    self.spec.note_documented(eid, sig or None, self.file or "", self.ln(i))
                for member in re.split(r"[,\s]+", options.get("members", "")):
                    found = self.spec.resolve_ref(member, None, eid) if member else None
                    if found:
                        self.spec.note_documented(found, None, self.file or "", self.ln(i))
            cls = eid if eid and self.spec.defs[eid]["kind"] in CLASS_KINDS else top["cls"]
            self.stack.append({"indent": ind, "entity": eid, "cls": cls, "tag": None,
                               "subject": None if eid else (target or arg)})
            self.session += 1
            return j
        if name in MODULE_DIRECTIVES:
            if arg and arg.split()[0] != "None":
                self.module = arg.split()[0]
            self.stack.append(dict(top, indent=ind))
            return j
        if name in CODE_DIRECTIVES:
            end = self.body_end(j, ind)
            self.add_code(j, end, name, lang=arg or None)
            return end
        if name not in ADMONITIONS:
            return self.body_end(j, ind)
        self.stack.append(dict(top, indent=ind, tag=name))
        if arg:
            if name in VERSION_LABELS:
                version, _, rest = arg.partition(" ")
                text = f"{VERSION_LABELS[name]} {version}." + (f" {rest}" if rest else "")
            else:
                text = arg
            self.new_para(i, ind + 1, text, tag=name)
            if name in VERSION_LABELS or name == "rubric":
                self.flush()
        return j


# ----------------------------------------------------------------------------------------------------
# Markdown (README.md, mkdocs)
# ----------------------------------------------------------------------------------------------------

class MarkdownParser:
    def __init__(self, spec: Spec, text, module):
        self.spec = spec
        self.lines = text.expandtabs().split("\n")
        self.module = module
        self.blocks: list[dict] = []
        self.entity = None
        self.skip_level = None
        self.session = 0
        self.para = None

    def flush(self):
        para, self.para = self.para, None
        if para:
            text = " ".join(s.strip() for s in para["lines"]).strip()
            if text:
                self.blocks.append({"type": "prose", "text": text, "line": para["line"], "nlines": len(para["lines"]),
                                    "entity": self.entity, "tag": para["tag"], "field": None,
                                    "skip": self.skip_level is not None, "module": self.module,
                                    "session": self.session})

    def heading(self, text, level):
        self.flush()
        self.entity = None
        self.session += 1
        if self.skip_level is not None and level <= self.skip_level:
            self.skip_level = None
        if self.skip_level is None and SKIP_HEADING.search(text.strip()):
            self.skip_level = level

    def code(self, body, first, lang):
        code = textwrap.dedent("\n".join(body)).strip("\n")
        if not code.strip():
            return
        base = {"line": first, "entity": self.entity, "skip": self.skip_level is not None, "module": self.module,
                "session": self.session}
        if any(l.lstrip().startswith(">>>") for l in code.split("\n")):
            self.blocks.append(dict(base, type="doctest", steps=parse_doctest(code.split("\n"), first)))
        else:
            self.blocks.append(dict(base, type="code", code=code, directive="fence", lang=lang))

    def parse(self):
        lines, n = self.lines, len(self.lines)
        i = 0
        while i < n:
            line = lines[i]
            stripped = line.strip()
            fence = re.match(r"^\s*(`{3,}|~{3,})\s*([\w+.-]*)", line)
            if fence:
                self.flush()
                marker, lang = fence.group(1), fence.group(2) or None
                j = i + 1
                while j < n and not lines[j].strip().startswith(marker):
                    j += 1
                self.code(lines[i + 1:j], i + 2, lang)
                i = j + 1
                continue
            if not stripped:
                self.flush()
                i += 1
                continue
            heading = re.match(r"^(#{1,6})\s+(.*?)\s*#*\s*$", stripped)
            if heading:
                self.heading(heading.group(2), len(heading.group(1)))
                i += 1
                continue
            nxt = lines[i + 1].strip() if i + 1 < n else ""
            if self.para is None and re.match(r"^(=+|-+)$", nxt) and not BULLET_RE.match(stripped):
                self.heading(stripped, 1 if nxt[0] == "=" else 2)
                i += 2
                continue
            doc = re.match(r"^:::\s+([\w.]+)", stripped)
            if doc:
                self.flush()
                self.entity = self.spec.resolve_ref(doc.group(1), self.module)
                if self.entity:
                    self.spec.note_documented(self.entity, None, "", i + 1)
                i = self.skip_indented(i + 1)
                continue
            if stripped.startswith((">>>",)):
                self.flush()
                j = i
                while j < n and lines[j].strip():
                    j += 1
                self.blocks.append({"type": "doctest", "steps": parse_doctest(lines[i:j], i + 1), "line": i + 1,
                                    "entity": self.entity, "skip": self.skip_level is not None,
                                    "module": self.module, "session": self.session})
                i = j
                continue
            if self.para is None and indent_of(line) >= 4:
                j = i
                while j < n and (not lines[j].strip() or indent_of(lines[j]) >= 4):
                    j += 1
                self.code(lines[i:j], i + 1, None)
                i = j
                continue
            if stripped.startswith(("<", "[![", "![", "|")) or re.match(r"^\[[^\]]+\]:\s", stripped):
                self.flush()
                i += 1
                continue
            bullet = BULLET_RE.match(stripped)
            quote = stripped.startswith(">")
            text = bullet.group(2) if bullet else stripped.lstrip("> ") if quote else stripped
            if bullet or self.para is None:
                self.flush()
                tag = None
                admonition = re.match(r"^\[!(NOTE|WARNING|IMPORTANT|TIP|CAUTION)\]", text, re.I)
                if admonition:
                    tag, text = admonition.group(1).lower(), text[admonition.end():].strip()
                self.para = {"lines": [text], "line": i + 1, "tag": tag}
            else:
                self.para["lines"].append(text)
            i += 1
        self.flush()
        return self.blocks

    def skip_indented(self, i):
        while i < len(self.lines) and (not self.lines[i].strip() or indent_of(self.lines[i]) > 0):
            i += 1
        return i


# ----------------------------------------------------------------------------------------------------

def build(args) -> Spec:
    root = Path.cwd().resolve()  # the workspace: the tool never reads outside it
    spec = Spec(root, args.private)
    spec.scan(args.package or [])
    if not spec.modules:
        print("extract_spec: found no Python package to scan (use --package)", file=sys.stderr)
    if not args.no_import:
        spec.enrich_at_runtime()
    spec.finish_names()
    spec.docs_claims(args.docs or [])   # docs first: they mark private names that are documented
    spec.docstring_claims()
    order = {"docstring": 0, "docstring (set at runtime)": 0, "readme": 1, "docs": 2}
    for claims in spec.claims.values():  # docstring claims before docs claims
        claims.sort(key=lambda c: order.get(c["source"]["origin"], 3))
    return spec


def main(argv=None) -> int:
    sys.dont_write_bytecode = True  # importing the package must not leave __pycache__ in the workspace
    argv = sys.argv[1:] if argv is None else argv
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    parser = argparse.ArgumentParser(prog="extract_spec", add_help=False)
    parser.add_argument("--list", action="store_true")
    parser.add_argument("--name")
    parser.add_argument("--claims")
    parser.add_argument("--compact", action="store_true")
    parser.add_argument("-o", "--output")
    parser.add_argument("--package", action="append")
    parser.add_argument("--docs", action="append", help=argparse.SUPPRESS)
    parser.add_argument("--private", action="store_true")
    parser.add_argument("--no-import", action="store_true")
    parser.add_argument("--no-general", action="store_true")
    args = parser.parse_args(argv)
    try:
        name_filter = re.compile(args.name) if args.name else None
    except re.error as error:
        print(f"extract_spec: bad --name pattern: {error}", file=sys.stderr)
        return 2
    kinds = {k.strip() for k in args.claims.split(",") if k.strip()} if args.claims else None
    spec = build(args)
    result = spec.to_json(name_filter, kinds, args.compact, general=not (args.no_general or name_filter))
    if args.list:
        for item in result["entities"]:
            signature = item.get("signature", "")
            print(f"{item['name']}{signature if item['kind'] not in ('property', 'module') else ''}"
                  f"  [{item['kind']}]  {len(item['claims'])} claims")
        if "general_claims" in result:
            print(f"(general claims: {len(result['general_claims'])})")
        return 0
    text = json.dumps(result, indent=1, ensure_ascii=False)
    if args.output:
        Path(args.output).write_text(text + "\n", encoding="utf-8")
        print(f"wrote {args.output}: {result['stats']['entities']} entities, {result['stats']['claims']} claims")
    else:
        print(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
